# ==============================================================================
# TRACE OSINT Digital Footprint Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend server:
#   cp .env.example .env
#
# NOTE: TRACE operates exclusively via passive surface-web queries and standard
# public protocols. No commercial API keys or sensitive credentials are required.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
ENVIRONMENT=development

# Database Storage Configuration
# SQLite local file path relative to backend root
DATABASE_PATH=trace.db

# Network & Timeout Configuration
# Per-source socket connection & read timeout in seconds
REQUEST_TIMEOUT_SECONDS=4.0
MAX_CONCURRENT_REQUESTS=10

# HTTP User-Agent string used for public profile reconnaissance
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36 TRACE-OSINT/1.0

# Academic Institutional Metadata (Used in Report Generation)
STUDENT_NAME=Fardeen Akmal
STUDENT_ROLL_NO=2
PROJECT_GUIDE=Akanksha Thakare
DEPARTMENT=Computer Science and Engineering (IoT, Cyber Security and Blockchain Technology)
INSTITUTE=G.V. Acharya Institute of Engineering and Technology
AFFILIATION=University of Mumbai
ACADEMIC_YEAR=2026-2027

